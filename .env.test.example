# Test environment — used by the API integration tests.
# Copy to `.env.test` before running `pnpm test`:
#   cp .env.test.example .env.test
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_hunter?schema=test"
API_PORT=4001
CORS_ORIGINS="http://localhost:3000"
SESSION_SECRET="test-only-secret-value-that-is-long-enough-1234567890"
AUTH_USERNAME="admin"
AUTH_PASSWORD="test-password-123"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
COOKIE_DOMAIN=""
SESSION_TTL_DAYS=1
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10000
UPLOAD_MAX_BYTES=5242880
API_PROXY_TARGET="http://localhost:4000"
NEXT_PUBLIC_API_URL=""

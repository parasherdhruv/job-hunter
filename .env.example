# =============================================================================
# Autonomous Job Hunter — example environment file
# Copy to `.env` and adjust. NEVER commit real secrets.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_hunter?schema=public"

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Comma-separated list of allowed browser origins (used only when the frontend
# talks to the API cross-origin; the default Next.js proxy is same-origin).
CORS_ORIGINS="http://localhost:3000"

# -----------------------------------------------------------------------------
# Authentication (single user)
# The first boot creates the user from these values if no user exists yet.
# Use a long random SESSION_SECRET (>= 32 chars) in every environment.
# -----------------------------------------------------------------------------
SESSION_SECRET="dev-only-change-me-please-use-a-long-random-secret-value"
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me-now"

# Session cookie behaviour.
#   COOKIE_SAME_SITE: lax | strict | none
#   COOKIE_SECURE:    true when served over HTTPS (production)
# Local development (http://localhost):  lax / false
# Production behind HTTPS:               none / true
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
# Leave empty unless you intentionally need to scope the cookie to a parent domain.
COOKIE_DOMAIN=""
# Session lifetime in days.
SESSION_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Rate limiting (per client IP)
# -----------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------------------------
# Resume upload
# -----------------------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# -----------------------------------------------------------------------------
# Web (Next.js)
# API_PROXY_TARGET is used by the Next.js server to proxy /api/* to the backend
# (same-origin, so cookies stay first-party). Required for both dev and prod.
# -----------------------------------------------------------------------------
API_PROXY_TARGET="http://localhost:4000"

# Optional: only set this to have the browser call the API directly
# (cross-origin). Leave empty to use the same-origin proxy above.
NEXT_PUBLIC_API_URL=""
